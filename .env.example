# Copy this file to .env (git-ignored). Everything here is OPTIONAL: the app works with this file empty.
#
# A free CARTO basemap key. No account and no card: request one at carto.com/basemaps/apikey.
# CARTO may ask for keys on its vector styles in future. One key per student, never a classmate's.
# EXPO_PUBLIC_ values are compiled into the app, so treat the key as public: it can only ever be
# throttled, never billed. Do not paste it into chat, commits or screenshots.
EXPO_PUBLIC_CARTO_KEY=

# Set to 1 to use a made-up sample route (lib/sampleReply.js) instead of calling the free routing
# server. Handy offline, or when the shared server is busy.
EXPO_PUBLIC_USE_SAMPLE_ROUTES=
